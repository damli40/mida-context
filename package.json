{
  "name": "mida-context",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "test:contracts": "cd contracts && forge test",
    "vectors:ids": "tsx packages/protocol/scripts/export-vectors.ts",
    "contracts:policy-hash": "node contracts/script/gen-policy-hash.mjs",
    "vectors:webauthn": "tsx packages/protocol/scripts/export-webauthn-fixture.ts",
    "chain:abis": "node packages/chain/scripts/gen-abis.mjs",
    "mida": "node --env-file=.env --import tsx apps/midad/src/cli.ts",
    "mida-hook": "node --import tsx apps/midad/src/hook-main.ts",
    "mida-drain": "node --import tsx apps/midad/src/drain-main.ts",
    "bench": "node --import tsx bench/run.ts"
  },
  "dependencies": {
    "@mida/api": "workspace:*",
    "@mida/chain": "workspace:*",
    "@mida/cli": "workspace:*",
    "@mida/crypto": "workspace:*",
    "@mida/fake-vault": "workspace:*",
    "@mida/grant-advisor": "workspace:*",
    "@mida/protocol": "workspace:*",
    "@mida/sdk": "workspace:*",
    "@mida/storage": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "fast-check": "4.9.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
