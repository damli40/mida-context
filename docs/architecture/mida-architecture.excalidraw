   "versionNonce": 138,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "If a save can't go out yet\n(the sponsor's daily limit, or the model\nat its usage limit), it waits on your\nmachine. Mida retries it, and the\nnext agent is told.",
   "originalText": "If a save can't go out yet\n(the sponsor's daily limit, or the model\nat its usage limit), it waits on your\nmachine. Mida retries it, and the\nnext agent is told.",
